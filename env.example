# Salin ke file .env di folder backend (jangan commit .env)
# Isi nilai dari Supabase Dashboard → Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=paste_service_role_jwt_here

SECRET_KEY=random-string-for-flask-sessions
JWT_SECRET_KEY=random-string-for-jwt-signing

# Origin Netlify + lokal (pisahkan koma)
ALLOWED_ORIGINS=https://your-site.netlify.app,http://127.0.0.1:5000
